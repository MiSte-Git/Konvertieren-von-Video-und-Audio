{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-schema/src/tauri.schema.json",
  "productName": "Konvertierung Audio-Video",
  "version": "0.1.0",
  "identifier": "de.michael.konvertierung",
  "build": {
    "beforeDevCommand": "python3 -m http.server 1420 --directory ./ui",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420/index.html?dev=2",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Konvertierung Audio-Video",
        "width": 900,
        "height": 620,
        "resizable": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/icon.png"
    ]
  }
}
