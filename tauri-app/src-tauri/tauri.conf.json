{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-schema/src/tauri.schema.json",
  "productName": "Konvertierung Audio-Video",
  "identifier": "de.michael.konvertierung",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "enableGTKAppId": false,
    "windows": [
      {
        "title": "Konvertierung Audio-Video",
        "width": 900,
        "height": 620,
        "resizable": true,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Video zu Audio konvertieren (ffmpeg/LAME)",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop/main.desktop",
        "depends": [
          "ffmpeg",
          "lame"
        ]
      },
      "rpm": {
        "desktopTemplate": "desktop/main.desktop",
        "depends": [
          "/usr/bin/ffmpeg",
          "/usr/bin/lame"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENjNEQUYyQzZDQTc4NDYKUldSR2VNckc4dHBqdmNwNW5xcTJYVGExdTJaK1pCajlNd3lTZ2NWRTJGdEl6YStHTkw4N1BoNm4K",
      "endpoints": [
        "https://github.com/MiSte-Git/Konvertieren-von-Video-und-Audio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
